bin/
obj/
*.user
.vs/
.superpowers/

# Unity project build artifacts (bundle path is optional; not tracked)
unity-project/Library/
unity-project/Temp/
unity-project/Obj/
unity-project/AssetBundles/
unity-project/**/*.meta
# retired empty unity projects (moved out of unity-project to fix nesting)
_unused-empty-unity-projects/

# Raw capture material - not needed for the build, and not published. The Workshop
# gallery images under docs/workshop are tracked and unaffected. These patterns are
# the default file names a Japanese Windows produces, so they have to stay in
# Japanese to match.
スクリーンショット*.png
レコーディング*
画像*.png
